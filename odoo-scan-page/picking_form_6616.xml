<data>
  <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='operations']/field[@name='move_ids']/list[1]/field[@name='product_id']" position="after">
    <field optional="show" name="x_studio_ref_pierre_f" column_invisible="True"/>
    <field optional="show" name="x_studio_n_of" string="N° OF"/>
    <field optional="show" name="production_id" string="N° OF (production)" readonly="1" column_invisible="True"/>
    <field optional="show" name="raw_material_production_id" string="N° OF (composant)" readonly="1" column_invisible="True"/>
  </xpath>
  <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='operations']/field[@name='move_ids']/list[1]/field[@name='product_uom_qty']" position="after">
    <field optional="show" name="x_studio_long_f_m" column_invisible="True"/>
    <field optional="show" name="x_studio_larg_f_m" column_invisible="True"/>
    <field optional="show" name="x_studio_haut_f_m" column_invisible="True"/>
  </xpath>
  <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='operations']/field[@name='move_ids']/list[1]/field[@name='product_uom']" position="after">
    <field optional="show" name="x_studio_udf"/>
    <field optional="show" name="x_studio_poids_kg"/>
  </xpath>
  <xpath expr="//header" position="inside">
    <button name="1962" type="action" string="✉ Envoyer BL par mail" class="btn-secondary"/>
  </xpath>
  <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='operations']/field[@name='move_ids']" position="before">
    <field name="x_studio_notes_bl" readonly="1" invisible="not x_studio_notes_bl" string="Notes de la commande"/>
  </xpath>
</data>