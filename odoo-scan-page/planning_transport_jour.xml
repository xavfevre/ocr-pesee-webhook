<t t-name="website.planning_transport_jour">
  <t t-call="website.layout">
    <t t-set="dparam" t-value="request.params.get('day')"/>
    <t t-set="today" t-value="datetime.date.today()"/>
    <t t-set="day" t-value="dparam and datetime.datetime.strptime(dparam, '%Y-%m-%d').date() or today"/>
    <t t-set="is_today" t-value="day == today"/>
    <t t-set="prev_d" t-value="(day - datetime.timedelta(days=1)).strftime('%Y-%m-%d')"/>
    <t t-set="next_d" t-value="(day + datetime.timedelta(days=1)).strftime('%Y-%m-%d')"/>
    <t t-set="jours_noms" t-value="['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche']"/>
    <t t-set="mois_noms" t-value="['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre']"/>
    <t t-set="palette" t-value="['#1f6f78','#b45309','#7c3aed','#be123c','#0f766e','#4d7c0f','#9d174d','#1d4ed8','#c2410c','#4338ca','#0e7490','#a16207','#7e22ce','#15803d','#9f1239']"/>

    <t t-set="df" t-value="day.strftime('%Y-%m-%d') + ' 00:00:00'"/>
    <t t-set="dt" t-value="(day + datetime.timedelta(days=1)).strftime('%Y-%m-%d') + ' 00:00:00'"/>
    <t t-set="day_records" t-value="request.env['project.task'].sudo().search([('project_id.name','=','Demande de transport'),('planned_date_begin','&gt;=',df),('planned_date_begin','&lt;',dt)], order='planned_date_begin')"/>

    <t t-set="selected_chauffeur" t-value="request.params.get('chauffeur', '')"/>
    <t t-set="selected_client" t-value="request.params.get('client', '')"/>
    <t t-set="chauffeurs_list" t-value="sorted(set([t.x_studio_chauffeur.display_name for t in day_records if t.x_studio_chauffeur]))"/>
    <t t-set="clients_list" t-value="sorted(set([t.partner_id.display_name for t in day_records if t.partner_id]))"/>
    <t t-if="selected_chauffeur">
      <t t-set="day_records" t-value="day_records.filtered(lambda t: t.x_studio_chauffeur and t.x_studio_chauffeur.display_name == selected_chauffeur)"/>
    </t>
    <t t-if="selected_client">
      <t t-set="day_records" t-value="day_records.filtered(lambda t: t.partner_id and t.partner_id.display_name == selected_client)"/>
    </t>

    <t t-set="bon_atts" t-value="request.env['x_project_task_worksheet_template_1'].sudo().search([('x_project_task_id','in',day_records.ids),('x_studio_photo_bon','!=',False)])"/>
    <t t-set="bon_map" t-value="{a.x_project_task_id.id: a.id for a in bon_atts}"/>
    <t t-set="pc_atts" t-value="request.env['x_project_task_worksheet_template_1'].sudo().search([('x_project_task_id','in',day_records.ids),('x_studio_photo','!=',False)])"/>
    <t t-set="pc_map" t-value="{a.x_project_task_id.id: a.id for a in pc_atts}"/>
    <t t-set="liv_atts" t-value="request.env['x_project_task_worksheet_template_1'].sudo().search([('x_project_task_id','in',day_records.ids),('x_studio_photo_1','!=',False)])"/>
    <t t-set="liv_map" t-value="{a.x_project_task_id.id: a.id for a in liv_atts}"/>

    <!-- Regroupement par client -->
    <t t-set="cl_stats" t-value="{}"/>
    <t t-foreach="day_records" t-as="t2_">
      <t t-set="c2n" t-value="t2_.partner_id.display_name if t2_.partner_id else 'Sans client'"/>
      <t t-set="cl_stats_x" t-value="cl_stats.update({c2n: cl_stats.get(c2n, 0) + 1})"/>
    </t>
    <t t-set="cl_sorted" t-value="sorted(cl_stats.items(), key=lambda kv: (-kv[1], kv[0]))"/>

    <t t-set="vehicles_used" t-value="set([t.x_studio_transport.id for t in day_records if t.x_studio_transport])"/>
    <t t-set="no_vehicle_count" t-value="len(day_records.filtered(lambda t: not t.x_studio_transport))"/>

    <!-- Résumé chauffeurs du jour -->
    <t t-set="drv_stats" t-value="{}"/>
    <t t-foreach="day_records" t-as="t_">
      <t t-set="dn" t-value="t_.x_studio_chauffeur.display_name if t_.x_studio_chauffeur else 'Non assigné'"/>
      <t t-set="dh" t-value="((t_.date_deadline - t_.planned_date_begin).total_seconds() / 3600.0) if (t_.date_deadline and t_.planned_date_begin) else 0"/>
      <t t-set="cur" t-value="drv_stats.get(dn, (0, 0.0))"/>
      <t t-set="drv_stats_x" t-value="drv_stats.update({dn: (cur[0] + 1, cur[1] + dh)})"/>
    </t>
    <t t-set="drv_sorted" t-value="sorted(drv_stats.items(), key=lambda kv: -kv[1][0])"/>

    <style>
      header#top, header.o_header_standard, footer, .o_footer, #o_cookies_bar, .o_bottom_fixed_element {display:none !important;}
      #wrapwrap &gt; main {padding-top:0 !important;}
      body{background:#eef2f6;}
      .ptj-wrap{max-width:none;width:100%;padding:14px 18px;box-sizing:border-box;}
      .ptj-topbar{background:#fff;border-radius:14px;box-shadow:0 1px 4px rgba(0,0,0,.08);padding:12px 16px;margin-bottom:12px;}
      .ptj-head{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap;}
      .ptj-head a.btn, .ptj-head input[type=date]{border:1px solid #cbd5e1;border-radius:10px;padding:8px 14px;font-weight:800;text-decoration:none;color:#0f172a;background:#fff;font-size:13.5px;}
      .ptj-head a.btn:hover{background:#f1f5f9;}
      .ptj-datebox{font-size:20px;font-weight:900;color:#15324f;min-width:280px;text-align:center;line-height:1.15;}
      .ptj-datebox small{display:block;font-weight:700;color:#94a3b8;font-size:12px;text-transform:uppercase;letter-spacing:.6px;}
      .ptj-summary{display:flex;justify-content:center;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px;font-weight:800;color:#334155;font-size:13px;}
      .ptj-summary select{border:1px solid #cbd5e1;border-radius:10px;padding:6px 10px;font-weight:700;font-size:13px;background:#fff;}
      .ptj-kpi{background:#f1f5f9;border-radius:10px;padding:4px 12px;}
      .ptj-kpi b{color:#0f172a;}
      .ptj-kpi.warn{background:#FEF3C7;color:#92400e;}
      .ptj-drivers{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:10px;}
      .ptj-drv-chip{background:#fff;border:1.5px solid #e2e8f0;border-radius:16px;padding:4px 12px;font-size:12.5px;font-weight:700;color:#0f172a;display:inline-flex;align-items:center;gap:6px;box-shadow:0 1px 2px rgba(0,0,0,.05);}
      .ptj-drv-chip .n{background:#0f172a;color:#fff;border-radius:9px;padding:0 7px;font-size:11px;}
      .ptj-drv-chip .h{color:#64748b;font-weight:600;}
      .ptj-clwrap{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:6px;margin-top:10px;}
      .ptj-cl-chip{display:inline-flex;align-items:center;gap:6px;border:1.5px solid #cbd5e1;border-radius:16px;padding:4px 12px 4px 9px;font-size:12.5px;font-weight:700;cursor:pointer;user-select:none;background:#fff;color:#334155;transition:opacity .15s;box-shadow:0 1px 2px rgba(0,0,0,.05);}
      .ptj-cl-chip .dot{width:10px;height:10px;border-radius:50%;flex:none;}
      .ptj-cl-chip .n{background:#f1f5f9;border-radius:9px;padding:0 7px;font-size:11px;color:#334155;font-weight:800;}
      .ptj-cl-chip.off{opacity:.3;}
      .ptj-cl-mini{border:1px solid #cbd5e1;border-radius:10px;background:#fff;font-size:12px;font-weight:700;padding:3px 10px;cursor:pointer;color:#334155;}
      .ptj-board{display:flex;gap:12px;overflow-x:auto;padding-bottom:12px;align-items:flex-start;}
      .ptj-col{background:#fff;border-radius:12px;box-shadow:0 1px 5px rgba(0,0,0,.09);min-width:280px;max-width:280px;flex:none;overflow:hidden;}
      .ptj-col-h{padding:10px 12px 8px;border-bottom:1px solid #eef2f6;}
      .ptj-col-band{height:5px;border-radius:12px 12px 0 0;}
      .ptj-col-title{font-weight:900;font-size:14px;color:#0f172a;line-height:1.25;}
      .ptj-col-sub{font-size:11.5px;color:#64748b;font-weight:700;margin-top:3px;}
      .ptj-col-body{padding:9px;max-height:74vh;overflow-y:auto;}
      .ttx{background:#fff;border:1px solid #e5eaf0;box-shadow:0 1px 3px rgba(0,0,0,.07);overflow:hidden;border-radius:10px;position:relative;margin-bottom:9px;transition:box-shadow .15s, transform .15s;cursor:pointer;}
      .ttx:hover{box-shadow:0 4px 12px rgba(0,0,0,.14);transform:translateY(-1px);}
      .ttx-head{background:#327279;color:#fff;font-weight:800;font-size:12.5px;line-height:1.3;padding:6px 26px 6px 11px;margin:0;white-space:normal;}
      .ttx-status{margin:0;padding:3px 4px;text-align:center;color:#fff;font-size:9.5px;font-weight:800;letter-spacing:.5px;line-height:1.4;}
      .ttx-body{font-size:12.5px;padding:6px 11px 9px;}
      .ttx-row{display:flex;align-items:center;gap:6px;margin-bottom:2px;}
      .ttx-veh{background:#0f172a;color:#fff;border-radius:7px;padding:1px 8px;font-size:11px;font-weight:800;display:inline-block;}
      .ttx-veh.none{background:#f59e0b;color:#78350f;}
      .ttx-driver{font-weight:800;color:#111827;}
      .ttx-time{font-weight:800;color:#0369a1;}
      .ttx-dur{color:#94a3b8;font-weight:700;font-size:11px;}
      .ttx-tags{margin-top:4px;line-height:1.7;}
      .ttx-tag{display:inline-block;background:#eef2ff;color:#3730a3;border:1px solid #c7d2fe;border-radius:8px;padding:0 6px;font-size:10px;font-weight:700;margin:1px 3px 0 0;}
      .ttx-links{margin-top:5px;display:flex;gap:10px;flex-wrap:wrap;font-size:12px;font-weight:800;border-top:1px dashed #e5eaf0;padding-top:5px;}
      .ttx-open{position:absolute;top:4px;right:7px;font-size:11px;text-decoration:none;z-index:2;}
      .ptj-empty{color:#94a3b8;font-size:12.5px;text-align:center;padding:18px 8px;}
      .ptj-nothing{background:#fff;border-radius:14px;box-shadow:0 1px 4px rgba(0,0,0,.08);padding:40px;text-align:center;color:#64748b;font-weight:700;}
    </style>

    <div class="ptj-wrap">
      <div class="ptj-topbar">
        <div class="ptj-head">
          <a t-attf-href="/planning-transport-jour?day={{prev_d}}&amp;{{keep_query('chauffeur', 'client')}}" class="btn">◀ Préc.</a>
          <div class="ptj-datebox">
            📅 <t t-esc="jours_noms[day.weekday()]"/> <t t-esc="day.day"/> <t t-esc="mois_noms[day.month - 1]"/> <t t-esc="day.year"/>
            <small><t t-if="is_today">Aujourd'hui</t><t t-else="">Semaine <t t-esc="day.isocalendar()[1]"/></t></small>
          </div>
          <a t-attf-href="/planning-transport-jour?day={{next_d}}&amp;{{keep_query('chauffeur', 'client')}}" class="btn">Suiv. ▶</a>
          <a t-attf-href="/planning-transport-jour?{{keep_query('chauffeur', 'client')}}" class="btn" style="background:#198754;color:#fff;border-color:#198754;">Aujourd'hui</a>
          <input type="date" id="ptjPick" t-att-value="day.strftime('%Y-%m-%d')"/>
          <a t-attf-href="/model/tache?limit=1000&amp;{{keep_query('chauffeur', 'client')}}" class="btn">🗓️ Vue semaine</a>
          <a t-attf-href="/planning-transport-mois?{{keep_query('client')}}" class="btn">📆 Vue mois</a>
        </div>

        <div class="ptj-summary">
          <select onchange="ptjFilter('chauffeur', this.value)">
            <option value="">👥 Tous chauffeurs</option>
            <t t-foreach="chauffeurs_list" t-as="ch">
              <option t-att-value="ch" t-att-selected="'selected' if ch == selected_chauffeur else None"><t t-esc="ch"/></option>
            </t>
          </select>
          <select onchange="ptjFilter('client', this.value)">
            <option value="">🏢 Tous clients</option>
            <t t-if="selected_client and selected_client not in clients_list">
              <option t-att-value="selected_client" selected="selected"><t t-esc="selected_client"/></option>
            </t>
            <t t-foreach="clients_list" t-as="cl">
              <option t-att-value="cl" t-att-selected="'selected' if cl == selected_client else None"><t t-esc="cl"/></option>
            </t>
          </select>
          <span class="ptj-kpi"><b><t t-esc="len(day_records)"/></b> tâche<t t-if="len(day_records) != 1">s</t></span>
          <span class="ptj-kpi"><b><t t-esc="len(cl_sorted)"/></b> client<t t-if="len(cl_sorted) != 1">s</t></span>
          <span class="ptj-kpi">🚛 <b><t t-esc="len(vehicles_used)"/></b> véhicule<t t-if="len(vehicles_used) != 1">s</t></span>
          <span t-if="no_vehicle_count" class="ptj-kpi warn">⚠ <b><t t-esc="no_vehicle_count"/></b> sans véhicule</span>
        </div>

        <div class="ptj-drivers" t-if="drv_sorted">
          <t t-foreach="drv_sorted" t-as="dv">
            <span class="ptj-drv-chip">👤 <t t-esc="dv[0]"/> <span class="n"><t t-esc="dv[1][0]"/></span><span class="h" t-if="dv[1][1] &gt; 0"><t t-esc="'%.1f' % dv[1][1]"/> h</span></span>
          </t>
        </div>

        <div class="ptj-clwrap" t-if="cl_sorted">
          <button type="button" class="ptj-cl-mini" id="ptjClAll">Tout</button>
          <button type="button" class="ptj-cl-mini" id="ptjClNone">Aucun</button>
          <t t-foreach="cl_sorted" t-as="cs">
            <t t-set="cscol" t-value="palette[sum([ord(ch) for ch in cs[0]]) % len(palette)]"/>
            <span class="ptj-cl-chip" t-att-data-client="cs[0]" t-attf-style="border-color:{{cscol}};">
              <span class="dot" t-attf-style="background:{{cscol}};"/> <t t-esc="cs[0]"/> <span class="n"><t t-esc="cs[1]"/></span>
            </span>
          </t>
        </div>
      </div>

      <t t-if="not day_records">
        <div class="ptj-nothing">🛌 Aucun transport planifié ce jour</div>
      </t>

      <!-- Une colonne par client, triées par volume décroissant -->
      <div class="ptj-board" t-if="day_records">
        <t t-foreach="cl_sorted" t-as="cs">
          <t t-set="cname_col" t-value="cs[0]"/>
          <t t-set="ccol_col" t-value="palette[sum([ord(ch) for ch in cname_col]) % len(palette)]"/>
          <t t-set="cl_tasks" t-value="day_records.filtered(lambda t: (t.partner_id.display_name if t.partner_id else 'Sans client') == cname_col)"/>
          <t t-set="cl_hours" t-value="sum([((t_.date_deadline - t_.planned_date_begin).total_seconds() / 3600.0) for t_ in cl_tasks if t_.date_deadline and t_.planned_date_begin])"/>
          <t t-set="cl_vehs" t-value="len(set([t.x_studio_transport.id for t in cl_tasks if t.x_studio_transport]))"/>
          <div class="ptj-col" t-att-data-client="cname_col">
            <div class="ptj-col-band" t-attf-style="background:{{ccol_col}};"/>
            <div class="ptj-col-h">
              <div class="ptj-col-title">🏢 <t t-esc="cname_col"/></div>
              <div class="ptj-col-sub">
                <t t-esc="len(cl_tasks)"/> tâche<t t-if="len(cl_tasks) != 1">s</t>
                <t t-if="cl_tasks"> · <t t-esc="cl_tasks[0].planned_date_begin.strftime('%H:%M')"/> → <t t-esc="(cl_tasks[-1].date_deadline or cl_tasks[-1].planned_date_begin).strftime('%H:%M')"/></t>
                <t t-if="cl_hours &gt; 0"> · <t t-esc="'%.1f' % cl_hours"/> h</t>
                <t t-if="cl_vehs"> · 🚛 <t t-esc="cl_vehs"/></t>
              </div>
            </div>
            <div class="ptj-col-body">
              <t t-foreach="cl_tasks" t-as="tache"><t t-call="website.ptj_task_card"/></t>
            </div>
          </div>
        </t>
      </div>
    </div>

    <script>
      function ptjFilter(key, val){
        var url = new URL(window.location);
        if(val){ url.searchParams.set(key, val); } else { url.searchParams.delete(key); }
        window.location.href = url.toString();
      }
      (function(){
        var pick = document.getElementById('ptjPick');
        if(pick){ pick.addEventListener('change', function(){
          var url = new URL(window.location); url.searchParams.set('day', pick.value);
          window.location.href = url.toString();
        }); }
        document.querySelectorAll('.ttx[data-id]').forEach(function(card){
          card.addEventListener('click', function (ev) {
            if (ev.target.closest('a')) { return; }
            window.open('/web#id=' + card.getAttribute('data-id') + '&amp;view_type=form&amp;model=project.task', '_blank');
          });
        });

        // Vignettes clients : affiche/masque la colonne du client
        var clChips = document.querySelectorAll('.ptj-cl-chip');
        var active = {};
        clChips.forEach(function(chip){ active[chip.getAttribute('data-client')] = true; });
        function applyClFilter(){
          document.querySelectorAll('.ptj-col[data-client]').forEach(function(col){
            col.style.display = active[col.getAttribute('data-client')] ? '' : 'none';
          });
          clChips.forEach(function(chip){
            chip.classList.toggle('off', !active[chip.getAttribute('data-client')]);
          });
        }
        clChips.forEach(function(chip){
          chip.addEventListener('click', function(){
            var c = chip.getAttribute('data-client');
            active[c] = !active[c];
            applyClFilter();
          });
        });
        var clAllBtn = document.getElementById('ptjClAll');
        if(clAllBtn){ clAllBtn.addEventListener('click', function(){ clChips.forEach(function(c){ active[c.getAttribute('data-client')] = true; }); applyClFilter(); }); }
        var clNoneBtn = document.getElementById('ptjClNone');
        if(clNoneBtn){ clNoneBtn.addEventListener('click', function(){ clChips.forEach(function(c){ active[c.getAttribute('data-client')] = false; }); applyClFilter(); }); }
      })();
    </script>
  </t>
</t>
