        var dragged = null;
        function pms(s){ var a = s.split(/[- :]/); return Date.UTC(+a[0], +a[1]-1, +a[2], +a[3]||0, +a[4]||0, +a[5]||0); }
        function fmtUTC(ms){ var d = new Date(ms); function z(n){ return ('0'+n).slice(-2); } return d.getUTCFullYear()+'-'+z(d.getUTCMonth()+1)+'-'+z(d.getUTCDate())+' '+z(d.getUTCHours())+':'+z(d.getUTCMinutes())+':'+z(d.getUTCSeconds()); }
        document.querySelectorAll('.tp-grip').forEach(function(g){
