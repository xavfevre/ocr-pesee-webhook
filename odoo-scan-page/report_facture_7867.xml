        <t t-if="payment_vals.get('pos_payment_name')"/>
      </i>
    </xpath><xpath position="replace" expr="//div[@id='total']/div/table/t[2]/t/t[3]/tr/td"/><xpath position="before" expr="//div[@id='total']/div/table/t[2]/t/t[3]/tr/td">
      <td>Montant Dû</td>
