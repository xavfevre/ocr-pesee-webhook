<data><xpath position="replace" expr="//div[@name='invoice_date']/t/strong"/><xpath position="inside" expr="//div[@name='invoice_date']/t">
      <strong>Date de<br/>facture</strong>
    </xpath><xpath position="replace" expr="//div[@name='due_date']/strong"/><xpath position="before" expr="//div[@name='due_date']/div[@t-field='o.invoice_date_due']">
      <strong>Date<br/> d'échéance</strong>
    </xpath><xpath position="replace" expr="//div[@name='delivery_date']/strong"/><xpath position="before" expr="//div[@name='delivery_date']/div[@t-field='o.delivery_date']">
      <strong>Date de<br/>livraison</strong>
    </xpath><xpath position="replace" expr="//div[@name='customer_code']/strong"/><xpath position="before" expr="//div[@name='customer_code']/div[@t-field='o.partner_id.ref']">
      <strong>Code Client</strong>
    </xpath><xpath position="after" expr="//th[@name='th_description']">
      <th t-if="any(line.x_studio_date_de_distribution for line in o.invoice_line_ids)">
