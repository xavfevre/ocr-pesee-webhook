        <p>
          <span t-field="line.x_studio_date_de_distribution"/>
          <br t-if="line.x_studio_date_de_distribution and (line.x_studio_nom_badge or line.x_studio_ref_chantier)"/>
          <span t-field="line.x_studio_nom_badge"/>
          <br t-if="line.x_studio_nom_badge and line.x_studio_ref_chantier"/>
          <span t-field="line.x_studio_ref_chantier"/>
        </p>
      </td>
      <td t-if="any(line.x_studio_ref_pierre for line in o.invoice_line_ids)">
        <span t-field="line.x_studio_ref_pierre"/>
      </td>
    </xpath><xpath position="replace" expr="//td[@name='account_invoice_line_name']/span[@t-field='line.name']">
      <t t-set="name_display" t-value="line.name or ''"/>
