      <t t-if="line.x_studio_libell_client">
        <span style="white-space:pre-line;" t-out="line.x_studio_libell_client"/>
      </t>
      <t t-else="">
        <span style="white-space:pre-line;" t-out="name_display"/>
      </t>
      <t t-if="line.x_studio_long_m &gt; 0 or line.x_studio_larg_m &gt; 0 or line.x_studio_haut_m &gt; 0">
        <br/>
        <small class="o_small-fs">
          <t t-if="line.x_studio_nbr_1 &gt; 0">Nbr : <t t-out="line.x_studio_nbr_1"/> - </t>
          <t t-if="line.x_studio_long_m &gt; 0">Long : <t t-out="line.x_studio_long_m"/> m - </t>
          <t t-if="line.x_studio_larg_m &gt; 0">Larg : <t t-out="line.x_studio_larg_m"/> m - </t>
          <t t-if="line.x_studio_haut_m &gt; 0">Haut : <t t-out="line.x_studio_haut_m"/> m</t>
        </small>
      </t>
    </xpath><xpath position="replace" expr="//td[@name='td_quantity']/span[@t-field='line.product_uom_id']">
      <t t-if="line.x_studio_udf">
        <span t-out="line.x_studio_udf" groups="uom.group_uom"/>
      </t>
