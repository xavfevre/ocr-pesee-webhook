        <span class="h5-fs">Communication de paiement :
      </span>
        <span class="fw-bold h5-fs" t-field="o.payment_reference">INV/2023/00001</span>
        <t t-if="o.partner_bank_id">
          <br/>
          <span class="h5-fs">
            <br/>
          </span>
        </t>
      </p>
    </xpath><xpath position="replace" expr="//div[@id='payment_term']/div[5]/p"/><xpath position="inside" expr="//div[@id='payment_term']/div[5]">
      <p t-if="o.l10n_fr_is_company_french and o.move_type.startswith('out_') and 'on_invoice' in o.invoice_line_ids.mapped('tax_ids.tax_exigibility')">
