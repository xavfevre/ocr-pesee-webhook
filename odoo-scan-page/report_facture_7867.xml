      <strong>
                                                </strong>
    </xpath><xpath position="replace" expr="//div[@id='total_payment_term_details_table']/div/t[2]/div"/><xpath position="inside" expr="//div[@id='total_payment_term_details_table']/div/t[2]">
      <div>
