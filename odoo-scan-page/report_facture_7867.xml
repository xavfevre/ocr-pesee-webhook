      </th>
      <th t-if="any(line.x_studio_ref_pierre for line in o.invoice_line_ids)" class="text-start">
        Réf. Pierre
      </th>
    </xpath><xpath position="replace" expr="//th[@name='th_subtotal']/span"/><xpath position="inside" expr="//th[@name='th_subtotal']">
      <span>Montant HT</span>
    </xpath><xpath position="replace" expr="//th[@name='th_taxes']/span"/><xpath position="inside" expr="//th[@name='th_taxes']">
      <span>Taxes</span>
