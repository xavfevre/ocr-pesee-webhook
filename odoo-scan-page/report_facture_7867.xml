        <strong>
          <br/>
        </strong>
      </span>
      <strong>
      </strong>
    </xpath><xpath position="attributes" expr="//span[@id='payment_terms_note_id']">
      <attribute name="class">h4-fs h5-fs</attribute>
      <attribute name="style">font-weight: bolder;</attribute>
    </xpath><xpath position="inside" expr="//div[@id='total_payment_term_details_table']/div/t">
      <span class="h4-fs h6-fs h5-fs" style="font-weight: bolder;">
        <strong>
      due if paid before
      </strong>
      </span>
