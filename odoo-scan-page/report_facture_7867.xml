                <t t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}" t-out="term.get('amount')" class="text-end h4-fs h6-fs h5-fs" style="font-weight: bolder;">31.05</t>
                <span class="h5-fs">
              </span>
                <strong>
        </strong>
