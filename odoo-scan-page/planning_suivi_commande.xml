<t t-name="website.planning_suivi_commande">
  <t t-call="website.layout">
    <t t-set="q" t-value="(request.params.get('q') or '').strip()"/>
    <t t-set="hidefact" t-value="request.params.get('hidefact')"/>
    <t t-set="dom" t-value="[('project_id','=',13)]"/>
    <t t-if="q"><t t-set="dom" t-value="dom + ['|','|',('name','ilike',q),('partner_id.name','ilike',q),('x_studio_devis_commandes_1.name','ilike',q)]"/></t>
    <t t-set="all_records" t-value="request.env['project.task'].sudo().search(dom, order='id desc')"/>
    <t t-set="stages" t-value="[(113,'📥 Nouvelle demande','#64748b',''),(119,'📝 Devis','#f59e0b','devis'),(114,'✅ Commande validée','#16a34a','cmd'),(115,'🏭 En fabrication','#2563eb','cmd'),(116,'📦 Prêt à expédier','#0891b2','cmd'),(117,'🚚 Expédié','#7c3aed','cmd'),(118,'💰 Facturé · non payé','#15803d','nonpaye'),(118,'💶 Facturé · payé','#0d6efd','paye'),(0,'🏭 OF non facturé','#b45309','ofnf'),(0,'⏸ Standby','#475569','sb')]"/>
    <!-- « Standby » : commandes dont au moins un OF a une opération garée sur le poste 27 « A replanifier (STANDBY) » -->
    <t t-set="sb_sos" t-value="request.env['sale.order'].sudo().browse([])"/>
    <!-- « OF non facturé » = même règle que le bouton de la liste des commandes : BC confirmé, à facturer, ≥ 1 OF non annulé (toutes étapes confondues) -->
    <t t-set="ofnf_sos" t-value="request.env['sale.order'].sudo().browse([])"/>
    <t t-set="_so_ofnf" t-value="lambda s: s.state == 'sale' and s.invoice_status == 'to invoice' and bool(s.order_line.mapped('x_of_ids').filtered(lambda o: o.state != 'cancel'))"/>

    <style>
      header#top, header.o_header_standard, footer, .o_footer, #o_cookies_bar, .o_bottom_fixed_element {display:none !important;}
      #wrapwrap &gt; main {padding-top:0 !important;}
      .sdc-board{display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;align-items:flex-start;}
      .sdc-col{flex:0 0 270px;background:#f1f5f9;border-radius:10px;padding:6px;}
      .sdc-colh{color:#fff;border-radius:8px;padding:6px 9px;font-weight:800;font-size:13px;display:flex;justify-content:space-between;align-items:center;}
      .sdc-colh small{font-weight:600;opacity:.9;}
      .sdc-card{background:#fff;border:1px solid #e2e8f0;border-left:4px solid #cbd5e1;border-radius:7px;padding:7px 8px;margin-top:7px;box-shadow:0 1px 2px rgba(0,0,0,.06);font-size:12px;}
      .sdc-title{font-weight:700;color:#0f172a;text-decoration:none;display:block;margin-bottom:3px;line-height:1.2;}
      .sdc-title:hover{color:#2563eb;}
      .sdc-so{display:flex;justify-content:space-between;gap:6px;font-size:11.5px;margin-top:2px;padding:1px 0;}
      .sdc-amt{font-weight:800;color:#15324f;white-space:nowrap;}
      .sdc-badge{display:inline-block;border-radius:8px;padding:0 6px;font-size:10px;font-weight:800;color:#fff;}
      .sdc-meta{font-size:10.5px;color:#64748b;margin-top:3px;}
    </style>

    <div class="container-fluid px-2 px-md-3 my-2">
      <h3 class="text-center mb-2" style="font-family:'Segoe UI',sans-serif;font-weight:300;color:#2c3e50;letter-spacing:1px;">📋 Suivi Devis / Commande</h3>

      <ul class="nav nav-tabs mb-2 flex-nowrap overflow-auto" style="font-size:15px;white-space:nowrap;">
        <li class="nav-item"><a class="nav-link" href="/planning-machines?board=complet">🏭 Board complet</a></li>
        <li class="nav-item"><a class="nav-link" href="/planning-machines?board=secondaire">🪚 Sciage secondaire</a></li>
        <li class="nav-item"><a class="nav-link" href="/planning-machines?board=primaire">🪨 Sciage primaire</a></li>
        <li class="nav-item"><a class="nav-link" href="/planning-operateurs">👷 Vue opérateurs</a></li>
        <li class="nav-item"><a class="nav-link" href="/planning-fabrication">📅 Vue semaine</a></li>
        <li class="nav-item"><a class="nav-link" href="/planning-mois">📆 Vue mois</a></li>
        <li class="nav-item"><a class="nav-link active fw-bold" href="#">📋 Suivi devis/commande</a></li>
      </ul>

      <form method="get" class="d-flex justify-content-center gap-2 mb-2">
        <input type="text" name="q" t-att-value="q" class="form-control form-control-sm w-auto" placeholder="Rechercher client / N° devis / commande..." style="min-width:280px;"/>
        <button type="submit" class="btn btn-primary btn-sm">🔍 Rechercher</button>
        <t t-if="q"><a href="/planning-suivi-commande" class="btn btn-outline-secondary btn-sm">✕ Effacer</a></t>
      </form>

      <div class="sdc-board">
        <t t-foreach="stages" t-as="stg">
          <t t-set="col_tasks" t-value="all_records.filtered(lambda t: t.stage_id.id == stg[0])"/>
            <t t-if="stg[3] == 'devis'">
              <t t-set="col_tasks" t-value="all_records.filtered(lambda t: t.x_studio_devis_commandes_1.filtered(lambda s: s.state in ('draft', 'sent')))"/>
            </t>
            <t t-if="stg[3] == 'nonpaye'">
              <t t-set="col_tasks" t-value="col_tasks.filtered(lambda t: t.x_studio_devis_commandes_1.invoice_ids.filtered(lambda x: x.state == 'posted' and x.move_type == 'out_invoice' and x.payment_state not in ('paid', 'in_payment', 'reversed', 'partial')))"/>
            </t>
            <t t-if="stg[3] == 'sb'">
              <t t-set="col_tasks" t-value="all_records.browse([])"/>
              <t t-set="sb_wos" t-value="request.env['mrp.workorder'].sudo().search([('workcenter_id','=',27),('state','not in',['done','cancel'])])"/>
              <t t-set="sb_ofs_all" t-value="sb_wos.mapped('production_id').filtered(lambda o: o.state not in ('done','cancel'))"/>
              <t t-set="sb_sos" t-value="sb_ofs_all.mapped('sale_line_id.order_id').filtered(lambda so: so.state != 'cancel').sorted(key=lambda so: (so.date_order, so.id))"/>
              <t t-if="q"><t t-set="sb_sos" t-value="sb_sos.filtered(lambda so: q.lower() in (so.name or '').lower() or q.lower() in (so.partner_id.name or '').lower() or q.lower() in (so.client_order_ref or '').lower())"/></t>
            </t>
            <t t-if="stg[3] == 'ofnf'">
              <t t-set="col_tasks" t-value="all_records.browse([])"/>
              <t t-set="ofnf_dom" t-value="[('state','=','sale'),('invoice_status','=','to invoice'),('order_line.x_of_ids.state','!=','cancel')]"/>
              <t t-if="q"><t t-set="ofnf_dom" t-value="ofnf_dom + ['|','|',('name','ilike',q),('partner_id.name','ilike',q),('client_order_ref','ilike',q)]"/></t>
              <t t-set="ofnf_sos" t-value="request.env['sale.order'].sudo().search(ofnf_dom, order='date_order asc, id asc')"/>
            </t>
            <t t-if="stg[3] == 'paye'">
              <t t-set="col_tasks" t-value="col_tasks.filtered(lambda t: t.x_studio_devis_commandes_1.invoice_ids.filtered(lambda x: x.state == 'posted' and x.move_type == 'out_invoice') and not t.x_studio_devis_commandes_1.invoice_ids.filtered(lambda x: x.state == 'posted' and x.move_type == 'out_invoice' and x.payment_state not in ('paid', 'in_payment', 'reversed', 'partial')))"/>
            </t>
          <t t-set="_colsos" t-value="lambda t: (t.x_studio_devis_commandes_1.filtered(lambda s: s.state in ('draft','sent')) if stg[3] == 'devis' else (t.x_studio_devis_commandes_1.filtered(lambda s: s.state not in ('draft','sent')) if stg[3] in ('cmd','nonpaye','paye') else (t.x_studio_devis_commandes_1.filtered(_so_ofnf) if stg[3] == 'ofnf' else t.x_studio_devis_commandes_1)))"/>
          <t t-set="col_total" t-value="sum([so.amount_total for so in ofnf_sos]) if stg[3] == 'ofnf' else (sum([so.amount_total for so in sb_sos]) if stg[3] == 'sb' else sum([so.amount_total for t in col_tasks for so in _colsos(t)]))"/>
          <t t-set="col_n" t-value="len(ofnf_sos) if stg[3] == 'ofnf' else (len(sb_sos) if stg[3] == 'sb' else len(col_tasks))"/>
          <div class="sdc-col" t-attf-style="{{'border:2px dashed #b45309;margin-left:14px;' if stg[3] == 'ofnf' else ('border:2px dashed #475569;' if stg[3] == 'sb' else '')}}">
            <div class="sdc-colh" t-attf-style="background:{{stg[2]}};">
              <span><t t-esc="stg[1]"/><small t-if="stg[3] == 'ofnf'" style="display:block;font-size:9.5px;opacity:.85;">filtre · toutes étapes · rouge = tous les OF terminés</small><small t-if="stg[3] == 'sb'" style="display:block;font-size:9.5px;opacity:.85;">filtre · OF garés sur « A replanifier »</small></span>
              <small><t t-esc="col_n"/> · <t t-esc="'%.0f' % col_total"/>€</small>
            </div>
            <t t-if="stg[3] == 'sb'">
              <t t-foreach="sb_sos" t-as="so">
                <t t-set="so_ofs" t-value="so.order_line.mapped('x_of_ids').filtered(lambda o: o.state != 'cancel')"/>
                <t t-set="so_sb" t-value="so_ofs.filtered(lambda o: o.id in sb_ofs_all.ids)"/>
                <t t-set="so_task" t-value="all_records.filtered(lambda t: so in t.x_studio_devis_commandes_1)[:1]"/>
                <div class="sdc-card" t-attf-style="border-left-color:{{stg[2]}};background:#f8fafc;">
                  <a t-attf-href="/web#id={{so.id}}&amp;model=sale.order&amp;view_type=form" target="_blank" class="sdc-title"><t t-esc="so.partner_id.name"/></a>
                  <div class="sdc-so">
                    <span><a t-attf-href="/web#id={{so.id}}&amp;model=sale.order&amp;view_type=form" target="_blank" style="text-decoration:none;color:#334155;font-weight:700;"><t t-esc="so.name"/></a> <span class="sdc-badge" t-attf-style="background:{{'#16a34a' if so.state == 'sale' else '#f59e0b'}};"><t t-esc="'Commande' if so.state == 'sale' else 'Devis'"/></span></span>
                    <span class="sdc-amt"><t t-esc="'%.0f' % so.amount_total"/>€</span>
                  </div>
                  <div class="sdc-meta" style="color:#334155;font-weight:800;">⏸ <t t-esc="len(so_sb)"/> OF en standby / <t t-esc="len(so_ofs)"/> OF · commande du <t t-esc="so.date_order.strftime('%d/%m/%y')"/></div>
                  <div class="sdc-meta"><t t-esc="', '.join([o.name for o in so_sb][:6])"/><t t-if="len(so_sb) &gt; 6">…</t></div>
                  <t t-if="so_task"><div class="sdc-meta">📋 <a t-attf-href="/web#id={{so_task.id}}&amp;model=project.task&amp;view_type=form" target="_blank" style="color:#64748b;"><t t-esc="so_task.name"/></a></div></t>
                </div>
              </t>
              <t t-if="not sb_sos"><div class="text-muted text-center small py-2">—</div></t>
            </t>
            <t t-if="stg[3] == 'ofnf'">
              <t t-foreach="ofnf_sos" t-as="so">
                <t t-set="so_ofs" t-value="so.order_line.mapped('x_of_ids').filtered(lambda o: o.state != 'cancel')"/>
                <t t-set="so_task" t-value="all_records.filtered(lambda t: so in t.x_studio_devis_commandes_1)[:1]"/>
                <t t-set="so_all_done" t-value="bool(so_ofs) and not so_ofs.filtered(lambda o: o.state != 'done')"/>
                <div class="sdc-card" t-attf-style="{{'border-left-color:#dc2626;background:#fef2f2;border-color:#fca5a5;' if so_all_done else 'border-left-color:' + stg[2] + ';'}}">
                  <a t-attf-href="/web#id={{so.id}}&amp;model=sale.order&amp;view_type=form" target="_blank" class="sdc-title"><t t-esc="so.partner_id.name"/></a>
                  <div class="sdc-so">
                    <span><a t-attf-href="/web#id={{so.id}}&amp;model=sale.order&amp;view_type=form" target="_blank" style="text-decoration:none;color:#334155;font-weight:700;"><t t-esc="so.name"/></a> <span class="sdc-badge" style="background:#16a34a;">Commande</span></span>
                    <span class="sdc-amt"><t t-esc="'%.0f' % so.amount_total"/>€</span>
                  </div>
                  <t t-set="so_rest" t-value="so.order_line.filtered(lambda l: not l.display_type and l.qty_to_invoice &gt; 0)"/>
                  <t t-set="so_rest_amt" t-value="sum([l.price_unit * l.qty_to_invoice * (1 - (l.discount or 0) / 100.0) for l in so_rest])"/>
                  <!-- facturé en trop : quantité à facturer négative (facture modifiée à la main) -->
                  <t t-set="so_over" t-value="so.order_line.filtered(lambda l: not l.display_type and not l.is_downpayment and l.qty_invoiced &gt; max(l.product_uom_qty, l.qty_delivered) + 0.001)"/>
                  <t t-set="so_over_amt" t-value="sum([l.price_unit * (l.qty_invoiced - max(l.product_uom_qty, l.qty_delivered)) * (1 - (l.discount or 0) / 100.0) for l in so_over])"/>
                  <t t-set="so_partiel" t-value="bool(so.invoice_ids.filtered(lambda i: i.state == 'posted' and i.move_type == 'out_invoice'))"/>
                  <t t-set="so_n_done" t-value="len(so_ofs.filtered(lambda o: o.state == 'done'))"/>
                  <!-- reste à facturer bien visible : bandeau orange, montant en gros — seulement si au moins un OF est terminé (sinon rien n'est facturable) -->
                  <div t-if="so_n_done and (so_rest or not so_over)" style="margin-top:5px;background:#fff7ed;border:1px solid #fdba74;border-radius:6px;padding:4px 7px;display:flex;justify-content:space-between;align-items:center;gap:6px;">
                    <span style="font-size:11px;font-weight:800;color:#9a3412;">🧾 Reste à facturer<t t-if="so_partiel"> <small style="font-weight:600;">(partiel)</small></t></span>
                    <span style="font-size:15px;font-weight:900;color:#c2410c;white-space:nowrap;"><t t-esc="'{:,.0f}'.format(so_rest_amt).replace(',', ' ')"/> € HT</span>
                  </div>
                  <div class="sdc-meta" t-if="so_rest and so_n_done"><t t-esc="', '.join([(l.product_id.name or l.name)[:28] for l in so_rest][:3])"/><t t-if="len(so_rest) &gt; 3"> +<t t-esc="len(so_rest) - 3"/></t></div>
                  <div t-if="so_over" style="margin-top:5px;background:#fef2f2;border:1px solid #fca5a5;border-radius:6px;padding:4px 7px;font-size:11px;font-weight:800;color:#991b1b;">
                    ⚠ Facturé en trop : <t t-esc="', '.join(['%s × %s' % (('%g' % (l.qty_invoiced - max(l.product_uom_qty, l.qty_delivered))), (l.product_id.name or l.name)[:26]) for l in so_over][:2])"/> — <t t-esc="'%.2f' % so_over_amt"/> € HT → avoir ou corriger la quantité
                  </div>
                  <div class="sdc-meta" t-if="not so_n_done" style="color:#94a3b8;">⏳ fabrication pas terminée — rien à facturer pour l'instant</div>
                  <div class="sdc-meta">commande du <t t-esc="so.date_order.strftime('%d/%m/%y')"/></div>
                  <div class="sdc-meta" t-attf-style="{{'color:#b91c1c;font-weight:800;' if so_all_done else ''}}">🏭 <t t-esc="len(so_ofs)"/> OF<t t-if="so_ofs"> · <t t-esc="len(so_ofs.filtered(lambda o: o.state == 'done'))"/> terminé(s)</t><t t-if="so_all_done"> — tout fabriqué, à facturer !</t></div>
                  <t t-set="so_pal" t-value="so_ofs.mapped('x_studio_colis') | request.env['x_repartition_palette'].sudo().search([('x_studio_of_id','in',so_ofs.ids)]).mapped('x_studio_colis_id')"/>
                  <t t-if="so_pal"><div class="sdc-meta">📦 <t t-esc="', '.join(so_pal.mapped('name'))"/></div></t>
                  <t t-if="so_task"><div class="sdc-meta">📋 <a t-attf-href="/web#id={{so_task.id}}&amp;model=project.task&amp;view_type=form" target="_blank" style="color:#64748b;"><t t-esc="so_task.name"/></a></div></t>
                </div>
              </t>
              <t t-if="not ofnf_sos"><div class="text-muted text-center small py-2">—</div></t>
            </t>
            <t t-foreach="col_tasks" t-as="task">
              <t t-set="sos" t-value="_colsos(task)"/>
              <t t-set="tamt" t-value="sum([s.amount_total for s in sos])"/>
              <div class="sdc-card" t-attf-style="border-left-color:{{stg[2]}};">
                <a t-attf-href="/web#id={{task.id}}&amp;model=project.task&amp;view_type=form" target="_blank" class="sdc-title"><t t-esc="task.name"/></a>
                <t t-foreach="sos" t-as="so">
                  <t t-set="so_label" t-value="'Commande' if so.state == 'sale' else ('Annulé' if so.state == 'cancel' else 'Devis')"/>
                  <t t-set="so_col" t-value="'#16a34a' if so.state == 'sale' else ('#dc3545' if so.state == 'cancel' else '#f59e0b')"/>
                  <div class="sdc-so">
                    <span><a t-attf-href="/web#id={{so.id}}&amp;model=sale.order&amp;view_type=form" target="_blank" style="text-decoration:none;color:#334155;font-weight:700;"><t t-esc="so.name"/></a> <span class="sdc-badge" t-attf-style="background:{{so_col}};"><t t-esc="so_label"/></span></span>
                    <span class="sdc-amt"><t t-esc="'%.0f' % so.amount_total"/>€</span>
                  </div>
                  <t t-if="so.invoice_status == 'invoiced'"><div class="sdc-meta">💰 Facturé</div></t>
                  <t t-elif="so.invoice_status == 'to invoice' and stg[3] in ('nonpaye', 'paye')">
                    <!-- dossier en étape Facturé mais commande pas entièrement facturée : badge d'alerte avec le reste -->
                    <t t-set="t_rest" t-value="so.order_line.filtered(lambda l: not l.display_type and l.qty_to_invoice &gt; 0)"/>
                    <t t-set="t_rest_amt" t-value="sum([l.price_unit * l.qty_to_invoice * (1 - (l.discount or 0) / 100.0) for l in t_rest])"/>
                    <t t-set="t_over" t-value="so.order_line.filtered(lambda l: not l.display_type and not l.is_downpayment and l.qty_invoiced &gt; max(l.product_uom_qty, l.qty_delivered) + 0.001)"/>
                    <t t-set="t_over_amt" t-value="sum([l.price_unit * (l.qty_invoiced - max(l.product_uom_qty, l.qty_delivered)) * (1 - (l.discount or 0) / 100.0) for l in t_over])"/>
                    <div class="sdc-meta" t-if="t_rest"><span class="sdc-badge" style="background:#f97316;" t-att-title="', '.join([(l.product_id.name or l.name) for l in t_rest])">⚠ reste <t t-esc="'%.0f' % t_rest_amt"/>€ HT à facturer</span> <span style="color:#9a3412;"><t t-esc="', '.join([(l.product_id.name or l.name)[:22] for l in t_rest][:2])"/></span></div>
                    <div class="sdc-meta" t-if="t_over"><span class="sdc-badge" style="background:#dc2626;" t-att-title="', '.join([(l.product_id.name or l.name) for l in t_over])">⚠ facturé en trop <t t-esc="'%.2f' % t_over_amt"/>€ HT</span> <span style="color:#991b1b;"><t t-esc="', '.join(['%s × %s' % (('%g' % (l.qty_invoiced - max(l.product_uom_qty, l.qty_delivered))), (l.product_id.name or l.name)[:20]) for l in t_over][:2])"/> → avoir</span></div>
                  </t>
                  <t t-elif="so.invoice_status == 'to invoice'"><div class="sdc-meta">🧾 À facturer</div></t>
                </t>
                <t t-set="nof" t-value="len(task.x_studio_of)"/>
                <t t-if="nof"><div class="sdc-meta">🏭 <t t-esc="nof"/> OF</div></t>
                <t t-set="pal_whole" t-value="task.x_studio_of.mapped('x_studio_colis')"/>
                <t t-set="pal_rep" t-value="request.env['x_repartition_palette'].sudo().search([('x_studio_of_id','in',task.x_studio_of.ids)]).mapped('x_studio_colis_id')"/>
                <t t-set="palettes" t-value="pal_whole | pal_rep"/>
                <t t-if="palettes"><div class="sdc-meta">📦 <t t-esc="', '.join(palettes.mapped('name'))"/></div></t>
              </div>
            </t>
            <t t-if="not col_tasks and stg[3] not in ('ofnf', 'sb')"><div class="text-muted text-center small py-2">—</div></t>
          </div>
        </t>
      </div>
    </div>
  </t>
</t>