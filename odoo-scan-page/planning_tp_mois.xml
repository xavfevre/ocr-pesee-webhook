<t t-name="website.planning_tp_mois">
  <t t-call="website.layout">
    <t t-set="month_param" t-value="request.httprequest.args.get('month')"/>
    <t t-set="selected_client" t-value="request.params.get('client', '')"/>
    <t t-set="today" t-value="datetime.date.today()"/>
    <t t-set="first" t-value="month_param and datetime.datetime.strptime(month_param, '%Y-%m').date() or today.replace(day=1)"/>
    <t t-set="prev_m" t-value="(first - datetime.timedelta(days=1)).replace(day=1).strftime('%Y-%m')"/>
    <t t-set="next_m" t-value="(first + datetime.timedelta(days=32)).replace(day=1).strftime('%Y-%m')"/>
    <t t-set="start_monday" t-value="first - datetime.timedelta(days=first.weekday())"/>
    <t t-set="grid_end" t-value="start_monday + datetime.timedelta(days=42)"/>
    <t t-set="dst0" t-value="datetime.datetime(start_monday.year,3,31,1) - datetime.timedelta(days=(datetime.datetime(start_monday.year,3,31).weekday()+1)%7)"/><t t-set="dst1" t-value="datetime.datetime(start_monday.year,10,31,1) - datetime.timedelta(days=(datetime.datetime(start_monday.year,10,31).weekday()+1)%7)"/><t t-set="df" t-value="(start_monday - datetime.timedelta(days=1)).strftime('%Y-%m-%d') + ' 21:00:00'"/>
    <t t-set="dt" t-value="grid_end.strftime('%Y-%m-%d') + ' 00:00:00'"/>
    <t t-set="all_records" t-value="request.env['project.task'].sudo().search([('tag_ids','in',[1]),('planned_date_begin','&gt;=',df),('planned_date_begin','&lt;',dt)], order='planned_date_begin')"/>
    <t t-set="bon_atts" t-value="request.env['x_project_task_worksheet_template_1'].sudo().search([('x_project_task_id','in',all_records.ids),('x_studio_photo_bon','!=',False)])"/>
    <t t-set="bon_map" t-value="{a.x_project_task_id.id: a.id for a in bon_atts}"/>
    <t t-set="pc_atts" t-value="request.env['x_project_task_worksheet_template_1'].sudo().search([('x_project_task_id','in',all_records.ids),('x_studio_photo','!=',False)])"/>
    <t t-set="pc_map" t-value="{a.x_project_task_id.id: a.id for a in pc_atts}"/>
    <t t-set="liv_atts" t-value="request.env['x_project_task_worksheet_template_1'].sudo().search([('x_project_task_id','in',all_records.ids),('x_studio_photo_1','!=',False)])"/>
    <t t-set="liv_map" t-value="{a.x_project_task_id.id: a.id for a in liv_atts}"/>
    <t t-if="selected_client"><t t-set="all_records" t-value="all_records.filtered(lambda t: t.partner_id and t.partner_id.display_name == selected_client)"/></t>
    <t t-set="palette" t-value="['#1f6f78','#b45309','#7c3aed','#be123c','#0f766e','#4d7c0f','#9d174d','#1d4ed8','#c2410c','#4338ca','#0e7490','#a16207','#7e22ce','#15803d','#9f1239']"/>
    <t t-set="mois_noms" t-value="['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre']"/>

    <style>
      header#top, header.o_header_standard, footer, .o_footer, #o_cookies_bar, .o_bottom_fixed_element {display:none !important;}
      #wrapwrap &gt; main {padding-top:0 !important;}
      .tpm-table{table-layout:fixed;width:100%;border-collapse:collapse;}
      .tpm-table th{background:#1f2937;color:#fff;font-size:12px;padding:5px;text-align:center;border:1px solid #374151;}
      .tpm-cell{border:1px solid #e2e8f0;vertical-align:top;height:118px;padding:3px;overflow:hidden;}
      .tpm-out{background:#f8fafc;}
      .tpm-today{background:#fef9c3;}
      .tpm-daynum{font-size:12px;font-weight:800;color:#334155;}
      .tpm-out .tpm-daynum{color:#cbd5e1;}
      .tpm-task{display:flex;align-items:center;gap:3px;color:#fff;border-radius:4px;padding:1px 4px;margin-top:2px;font-size:10.5px;font-weight:700;}
      .tpm-txt{color:#fff;text-decoration:none;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
      .tpm-txt:hover{color:#fff;text-decoration:underline;}
      .tpm-bon{color:#fff;text-decoration:none;flex:none;font-size:11px;}
      .tpm-bon:hover{opacity:.75;}
    </style>

    <div class="container-fluid px-2 px-md-3 my-2">
      <h3 class="text-center mb-2" style="font-family:'Segoe UI',sans-serif;font-weight:300;color:#2c3e50;letter-spacing:1px;">📅 Planning TP — Vue mois</h3>

      <div class="text-center mb-2 d-flex flex-wrap justify-content-center align-items-center gap-2">
        <a t-attf-href="?month={{prev_m}}&amp;client={{selected_client}}" class="btn btn-outline-primary btn-sm"><i class="fa fa-chevron-left"/> Préc.</a>
        <span class="fw-bold" style="font-size:17px;color:#15324f;min-width:170px;"><t t-esc="mois_noms[first.month - 1]"/> <t t-esc="first.year"/></span>
        <a t-attf-href="?month={{next_m}}&amp;client={{selected_client}}" class="btn btn-outline-primary btn-sm">Suiv. <i class="fa fa-chevron-right"/></a>
        <a t-attf-href="?client={{selected_client}}" class="btn btn-success btn-sm">Mois en cours</a>
        <a t-attf-href="/planning-tp" class="btn btn-outline-secondary btn-sm">🗓️ Vue semaine</a>
      </div>

      <div class="text-center mb-2">
        <t t-set="clients_f" t-value="sorted(set(t.partner_id.display_name for t in all_records if t.partner_id))"/>
        <select class="form-select form-select-sm w-auto d-inline-block" onchange="var u=new URL(window.location);if(this.value){u.searchParams.set('client',this.value);}else{u.searchParams.delete('client');}window.location.href=u.toString();">
          <option value="">🏢 Tous clients</option>
          <t t-foreach="clients_f" t-as="cl">
            <option t-att-value="cl" t-att-selected="'selected' if cl == selected_client else None"><t t-esc="cl"/></option>
          </t>
        </select>
      </div>

      <table class="tpm-table">
        <thead>
          <tr>
            <th>Lundi</th><th>Mardi</th><th>Mercredi</th><th>Jeudi</th><th>Vendredi</th><th>Samedi</th><th>Dimanche</th>
          </tr>
        </thead>
        <tbody>
          <t t-foreach="range(6)" t-as="w">
            <tr>
              <t t-foreach="range(7)" t-as="d">
                <t t-set="cd" t-value="start_monday + datetime.timedelta(days=w*7+d)"/>
                <t t-set="is_today" t-value="cd == today"/>
                <t t-set="in_month" t-value="cd.month == first.month"/>
                <t t-set="day_tasks" t-value="all_records.filtered(lambda t: (t.planned_date_begin + datetime.timedelta(hours=2 if (dst0 &lt;= t.planned_date_begin and t.planned_date_begin &lt; dst1) else 1)).date() == cd)"/>
                <td t-attf-class="tpm-cell {{'tpm-today' if is_today else ('tpm-out' if not in_month else '')}}">
                  <div class="tpm-daynum"><t t-esc="cd.day"/><t t-if="is_today"> ⭐</t></div>
                  <t t-foreach="day_tasks" t-as="task">
                    <t t-set="cname" t-value="task.partner_id.display_name or 'Sans client'"/>
                    <t t-set="ccol" t-value="palette[sum([ord(ch) for ch in cname]) % len(palette)]"/>
                    <div class="tpm-task" t-attf-style="background:{{ccol}};" t-att-title="cname">
                      <a t-attf-href="/web#id={{task.id}}&amp;model=project.task&amp;view_type=form" target="_blank" class="tpm-txt"><t t-if="task.planned_date_begin"><t t-esc="(task.planned_date_begin + datetime.timedelta(hours=2 if (dst0 &lt;= task.planned_date_begin and task.planned_date_begin &lt; dst1) else 1)).strftime('%H:%M')"/> </t><t t-esc="cname"/></a>
                      <t t-if="bon_map.get(task.id)"><a t-attf-href="/web/image/x_project_task_worksheet_template_1/{{bon_map[task.id]}}/x_studio_photo_bon" target="_blank" class="tpm-bon" title="Voir le bon scanné">📎</a></t><t t-if="pc_map.get(task.id)"><a t-attf-href="/web/image/x_project_task_worksheet_template_1/{{pc_map[task.id]}}/x_studio_photo" target="_blank" class="tpm-bon" title="Photo prise en charge">📥</a></t><t t-if="liv_map.get(task.id)"><a t-attf-href="/web/image/x_project_task_worksheet_template_1/{{liv_map[task.id]}}/x_studio_photo_1" target="_blank" class="tpm-bon" title="Photo livraison">🏁</a></t><t t-set="_bc" t-value="task.sale_line_id.order_id if task.sale_line_id else task.sale_order_id"/><t t-if="_bc"><a t-attf-href="/web#id={{_bc.id}}&amp;model=sale.order&amp;view_type=form" target="_blank" class="tpm-bon" t-att-title="'BC: ' + _bc.name">🧾</a></t>
                    </div>
                  </t>
                </td>
              </t>
            </tr>
          </t>
        </tbody>
      </table>
    </div>
  </t>
</t>