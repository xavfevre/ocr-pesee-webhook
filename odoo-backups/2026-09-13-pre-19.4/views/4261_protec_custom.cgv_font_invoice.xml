<data>
  <xpath expr="//div[@name='comment']" position="attributes">
    <attribute name="style">page-break-before:always;font-size:10px;line-height:1.3;</attribute>
  </xpath>
  <xpath expr="//div[@name='comment']" position="before">
    <style>div[name="comment"] span &gt; div &gt; div:first-child { font-size: 1.8em; margin-bottom: 4px; }</style>
  </xpath>
</data>