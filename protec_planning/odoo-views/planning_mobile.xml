<t t-name="website.planning_protec_mobile">
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Planning PROTEC — Mobile</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
           background: #f0f4f8; color: #1a2e4a; padding-bottom: 24px; }
    header { background: #3a5a99; color: #fff; position: sticky; top: 0; z-index: 100;
             box-shadow: 0 2px 8px rgba(0,0,0,.3); padding: 10px 12px; }
    .h-row { display: flex; align-items: center; gap: 8px; }
    .h-title { font-size: 16px; font-weight: 800; flex: 1; }
    .soc-chip { background: rgba(255,255,255,.12); border: 1.5px dashed rgba(255,255,255,.55);
                color: #fff; border-radius: 16px; padding: 4px 10px; font-size: 11px;
                font-weight: 800; text-decoration: none; }
    .soc-chip.active { background: #fff; color: #3a5a99; border-style: solid; }
    .nav-row { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
    .nav-btn { background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.35);
               color: #fff; border-radius: 10px; padding: 8px 14px; font-size: 15px;
               font-weight: 800; text-decoration: none; }
    .day-label { flex: 1; text-align: center; font-size: 15px; font-weight: 800; }
    .day-label.today { color: #ffd28a; }
    .desk-link { font-size: 11px; color: rgba(255,255,255,.75); text-decoration: none; }

    .emp-band { margin: 12px 10px 0; border-radius: 12px 12px 0 0; color: #fff;
                padding: 8px 14px; display: flex; align-items: center; justify-content: space-between; }
    .emp-band .en { font-size: 15px; font-weight: 800; }
    .emp-band .ec { font-size: 12px; opacity: .85; font-weight: 700; }
    .emp-body { margin: 0 10px; background: #fff; border: 1px solid #dce3ef; border-top: none;
                border-radius: 0 0 12px 12px; padding: 8px; }
    .emp-body.conge { background: repeating-linear-gradient(45deg, #fde2e2, #fde2e2 6px, #fff3f3 6px, #fff3f3 12px);
                      text-align: center; font-weight: 900; color: #b91c1c; padding: 10px; font-size: 13px; }
    .emp-body.vide { text-align: center; color: #94a3b8; font-size: 12px; padding: 8px; }

    .mcard { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; margin-bottom: 8px; }
    .mcard:last-child { margin-bottom: 0; }
    .mc-head { color: #fff; padding: 6px 10px; display: flex; align-items: center;
               justify-content: space-between; gap: 6px; }
    .mc-time { font-size: 14px; font-weight: 900; }
    .badges { display: flex; gap: 4px; }
    .nuit-badge { font-size: 10px; font-weight: 800; color: #fff; background: #312e81;
                  border-radius: 4px; padding: 1px 5px; }
    .fdt-badge { font-size: 10px; font-weight: 800; color: #fff; background: #16a34a;
                 border-radius: 4px; padding: 1px 5px; }
    .bc-link { font-size: 11px; font-weight: 800; color: #fff; text-decoration: none;
               border: 1px solid rgba(255,255,255,.6); border-radius: 4px; padding: 0 6px; }
    .mc-body { padding: 7px 10px 9px; }
    .mc-client { font-size: 14px; font-weight: 800; margin-bottom: 3px; }
    .mc-row { font-size: 13px; line-height: 1.45; color: #334562; }
    .mc-row a { color: #2563eb; font-weight: 700; text-decoration: none; }
    .mc-ref { font-size: 11px; color: #8fa0bd; font-weight: 600; margin-top: 2px; }
  </style>
</head>
<body>
<t t-set="args" t-value="request.httprequest.args"/>
<t t-set="soc" t-value="args.get('soc') or 'protec'"/>
<t t-set="soc_cid" t-value="2 if soc == 'protec' else (1 if soc == 's3t' else 0)"/>
<t t-set="nuit" t-value="(args.get('n') or '1') != '0'"/>
<t t-set="tnow" t-value="datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)"/>
<t t-set="yr" t-value="tnow.year"/>
<t t-set="dst_a" t-value="max([datetime.date(yr,3,x) for x in range(25,32) if datetime.date(yr,3,x).weekday()==6])"/>
<t t-set="dst_b" t-value="max([datetime.date(yr,10,x) for x in range(25,32) if datetime.date(yr,10,x).weekday()==6])"/>
<t t-set="off" t-value="2 if dst_a &lt;= tnow.date() &lt; dst_b else 1"/>
<t t-set="dtoff" t-value="datetime.timedelta(hours=off)"/>
<t t-set="today" t-value="(tnow + dtoff).date()"/>
<t t-set="dstr" t-value="args.get('d') or ''"/>
<t t-set="d" t-value="datetime.date(int(dstr[:4]), int(dstr[5:7]), int(dstr[8:10])) if len(dstr) == 10 else today"/>
<t t-set="omap" t-value="{4: 1, 5: 2, 6: 3, 7: 4, 10: 5, 2: 6, 8: 7, 9: 8, 1: 9}"/>
<t t-set="cmap" t-value="{4: '#2563eb', 5: '#eab308', 6: '#dc2626', 7: '#111827', 10: '#7c3aed', 2: '#7c3aed', 8: '#0d9488', 1: '#db2777', 9: '#ea580c'}"/>
<t t-set="palette" t-value="['#2563eb','#16a34a','#ea580c','#9333ea','#0d9488','#db2777','#ca8a04','#4f46e5','#dc2626','#0891b2']"/>
<t t-set="emps0" t-value="[e for e in request.env['hr.employee'].sudo().search([('active','=',True)], order='name') if e.id not in (1, 3, 8, 9) and (not soc_cid or e.company_id.id == soc_cid)]"/>
<t t-set="emps" t-value="[e for k in sorted([(omap.get(z.id, 99), z.name, z.id) for z in emps0]) for e in emps0 if e.id == k[2]]"/>
<t t-set="mois_abr" t-value="['jan','fév','mar','avr','mai','juin','juil','août','sep','oct','nov','déc']"/>
<t t-set="jours_long" t-value="['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche']"/>
<t t-set="su" t-value="datetime.datetime(d.year, d.month, d.day) - dtoff"/>
<t t-set="dom" t-value="[('start_datetime','&lt;',su + datetime.timedelta(days=1)),('end_datetime','&gt;',su)] + ([('company_id','=',soc_cid)] if soc_cid else [])"/>
<t t-set="slots" t-value="request.env['planning.slot'].sudo().search(dom, order='start_datetime')"/>
<t t-set="somap" t-value="dict([(o.name, o) for o in request.env['sale.order'].sudo().search([('name','in',[((s.name or '').strip().split() or [''])[0] for s in slots])])])"/>
<t t-set="bimap" t-value="dict([(p.origin, p.x_camion_id.name) for p in request.env['stock.picking'].sudo().search([('origin','in',list(somap.keys())),('x_camion_id','!=',False)])])"/>
<t t-set="leaves" t-value="request.env['resource.calendar.leaves'].sudo().search([('resource_id','!=',False),('date_from','&lt;',su + datetime.timedelta(days=1)),('date_to','&gt;',su)])"/>
<t t-set="qsoc" t-value="('&amp;soc=%s' % soc) if soc != 'protec' else ''"/>

<header>
  <div class="h-row">
    <div class="h-title">📱 Planning PROTEC</div>
    <a t-att-href="'/planning-mobile?d=%s' % d.isoformat()" t-att-class="'soc-chip' + (' active' if soc == 'protec' else '')">PROTEC</a>
    <a t-att-href="'/planning-mobile?d=%s&amp;soc=s3t' % d.isoformat()" t-att-class="'soc-chip' + (' active' if soc == 's3t' else '')">S3T</a>
  </div>
  <div class="nav-row">
    <a t-att-href="'/planning-mobile?d=%s%s' % ((d - datetime.timedelta(days=1)).isoformat(), qsoc)" class="nav-btn">‹</a>
    <span t-att-class="'day-label' + (' today' if d == today else '')" t-out="'%s %s %s %s' % (jours_long[d.weekday()], d.day, mois_abr[d.month-1], d.year)"/>
    <a t-att-href="'/planning-mobile?d=%s%s' % ((d + datetime.timedelta(days=1)).isoformat(), qsoc)" class="nav-btn">›</a>
  </div>
  <div class="nav-row" style="justify-content: space-between;">
    <a t-if="d != today" t-att-href="'/planning-mobile?d=%s%s' % (today.isoformat(), qsoc)" class="nav-btn" style="font-size:12px;">Aujourd’hui</a>
    <span t-else=""/>
    <a t-att-href="'/planning-semaine?w=0%s' % qsoc" class="desk-link">💻 Vue complète</a>
  </div>
</header>

<t t-foreach="emps" t-as="emp">
  <t t-set="color" t-value="cmap.get(emp.id, palette[emp.id % 10])"/>
  <t t-set="cell" t-value="[s for s in slots if emp.id in s.employee_ids.ids and (not nuit or (s.start_datetime + dtoff).date() == d or (s.start_datetime + dtoff).hour &lt; 18 or s.x_nuit_etale or (s.end_datetime and (s.end_datetime + dtoff).date() &gt; d))]"/>
  <t t-set="onleave" t-value="[l for l in leaves if l.resource_id.id == emp.resource_id.id]"/>
  <t t-set="emin" t-value="sum([int((s.end_datetime - s.start_datetime).total_seconds() // 60) for s in cell if s.end_datetime])"/>
  <div class="emp-band" t-att-style="'background: %s;' % color">
    <span class="en" t-out="emp.name"/>
    <span class="ec" t-out="('%s interv. · %s' % (len(cell), (('%sh%02d' % (emin // 60, emin % 60)) if emin % 60 else ('%sh' % (emin // 60))))) if cell else ('CONGÉS' if onleave else '—')"/>
  </div>
  <div t-if="onleave and not cell" class="emp-body conge">CONGÉS</div>
  <div t-elif="not cell" class="emp-body vide">Aucune intervention</div>
  <div t-else="" class="emp-body">
    <t t-foreach="cell" t-as="s">
      <t t-set="so" t-value="somap.get(((s.name or '').strip().split() or [''])[0])"/>
      <t t-set="so_url" t-value="('/web#id=%s&amp;model=sale.order&amp;view_type=form' % so.id) if so else ''"/>
      <t t-set="st" t-value="s.start_datetime + dtoff"/>
      <t t-set="en" t-value="(s.end_datetime + dtoff) if s.end_datetime else st"/>
      <t t-set="lieu" t-value="(so.x_studio_lieu_dintervention_2 or '') if so else ''"/>
      <t t-set="adr" t-value="lieu if lieu else (((s.partner_street + ', ') if s.partner_street else '') + ((s.partner_zip + ' ') if s.partner_zip else '') + (s.partner_city or ''))"/>
      <div class="mcard">
        <div class="mc-head" t-att-style="'background: %s;' % color">
          <span class="mc-time" t-out="st.strftime('%H:%M') + ' → ' + (en.strftime('%d/%m %H:%M') if en.date() != st.date() else en.strftime('%H:%M'))"/>
          <span class="badges">
            <span t-if="s.end_datetime and (s.end_datetime + dtoff).date() != (s.start_datetime + dtoff).date() and (s.start_datetime + dtoff).hour &gt;= 18" class="nuit-badge">🌙</span>
            <span t-if="s.x_fdt_fait" class="fdt-badge">✓ FDT</span>
            <a t-if="so_url" class="bc-link" t-att-href="so_url" target="_blank">BC ↗</a>
          </span>
        </div>
        <div class="mc-body">
          <div class="mc-client" t-out="s.partner_id.name or (s.name or '—')[:40]"/>
          <div t-if="adr" class="mc-row">📍 <a t-att-href="'https://www.google.com/maps/search/?api=1&amp;query=' + adr.replace(' ', '+').replace('&amp;', '')" target="_blank" t-out="adr"/></div>
          <div t-if="so and so.x_studio_interlocuteur_1" class="mc-row" t-out="'👤 ' + so.x_studio_interlocuteur_1[:80]"/>
          <div t-if="s.partner_phone" class="mc-row">📞 <a t-att-href="'tel:' + s.partner_phone.replace(' ', '')" t-out="s.partner_phone"/></div>
          <div t-if="so and so.x_studio_lieu_dintervention_1" class="mc-row" t-out="'🛠 ' + so.x_studio_lieu_dintervention_1[:80]"/>
          <div t-if="so and bimap.get(so.name)" class="mc-row" t-out="'🚚 ' + bimap.get(so.name)"/>
          <div t-if="s.name" class="mc-ref" t-out="(s.name or '')[:36]"/>
        </div>
      </div>
    </t>
  </div>
</t>

<t t-set="naslots" t-value="[s for s in slots if not [i for i in s.employee_ids.ids if i not in (1, 3, 8, 9)]]"/>
<t t-if="naslots">
  <div class="emp-band" style="background: #64748b;">
    <span class="en">Non assigné</span>
    <span class="ec" t-out="'%s interv.' % len(naslots)"/>
  </div>
  <div class="emp-body">
    <t t-foreach="naslots" t-as="s">
      <t t-set="st" t-value="s.start_datetime + dtoff"/>
      <t t-set="en" t-value="(s.end_datetime + dtoff) if s.end_datetime else st"/>
      <div class="mcard">
        <div class="mc-head" style="background: #64748b;">
          <span class="mc-time" t-out="st.strftime('%H:%M') + ' → ' + en.strftime('%H:%M')"/>
        </div>
        <div class="mc-body">
          <div class="mc-client" t-out="s.partner_id.name or (s.name or '—')[:40]"/>
          <div t-if="s.partner_city" class="mc-row" t-out="'📍 ' + s.partner_city"/>
        </div>
      </div>
    </t>
  </div>
</t>

</body>
</html>
</t>