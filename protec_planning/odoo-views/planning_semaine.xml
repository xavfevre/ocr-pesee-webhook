<!-- ir.ui.view id=4162 key=website.planning_protec_semaine - page website protec-s3t.odoo.com -->
<t t-name="website.planning_protec_semaine">
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Planning PROTEC — Semaine</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
           background: #f0f4f8; color: #1a2e4a; min-height: 100vh; }
    header { background: #3a5a99; color: #fff; position: sticky; top: 0; z-index: 200;
             box-shadow: 0 2px 10px rgba(0,0,0,.3); }
    .hdr-top { display: flex; align-items: center; gap: 12px; padding: 10px 16px 6px; }
    .logo { width: 34px; height: 34px; background: #fff; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 15px; color: #3a5a99; flex-shrink: 0; }
    .hdr-title { font-size: 17px; font-weight: 700; }
    .hdr-sub { font-size: 11px; opacity: .7; margin-top: 1px; }
    .badge { background: rgba(255,255,255,.2); border-radius: 20px; padding: 3px 12px;
             font-size: 13px; font-weight: 700; white-space: nowrap; }
    .hdr-nav { display: flex; align-items: center; gap: 8px; padding: 6px 16px 10px; flex-wrap: wrap; }
    .nav-btn { background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.3);
               color: #fff; border-radius: 8px; padding: 6px 14px; font-size: 13px;
               font-weight: 600; cursor: pointer; text-decoration: none; white-space: nowrap; }
    .nav-btn:hover { background: rgba(255,255,255,.3); }
    .nav-btn.active { background: #fff; color: #3a5a99; }
    .period-label { flex: 1; text-align: center; font-size: 15px; font-weight: 700; min-width: 130px; }
    .drv-select { border: 1px solid rgba(255,255,255,.4); background: rgba(255,255,255,.15);
                  color: #fff; border-radius: 8px; padding: 6px 8px; font-size: 13px; font-weight: 600; }
    .drv-select option { color: #1a2e4a; }
    table.pl { border-collapse: separate; border-spacing: 0; min-width: max-content; width: 100%; }
    table.pl thead th { color: #fff; padding: 0; }
    th.emp-col { background: #2c4880; position: sticky; left: 0; z-index: 150; }
    th.day-th { background: #3a5a99; }
    th.day-th.is-today { background: #f59e0b; }
    .th-inner { padding: 6px 8px; min-width: 170px; max-width: 200px; text-align: center; }
    .th-emp-inner { padding: 6px 8px; min-width: 120px; max-width: 140px; text-align: left; }
    .th-day-dow { font-size: 12px; font-weight: 800; text-transform: uppercase; }
    .th-day-num { font-size: 15px; font-weight: 900; line-height: 1.1; }
    td.emp-cell { position: sticky; left: 0; z-index: 50; background: #fff;
                  border-right: 2px solid #dce3ef; border-bottom: 1px solid #dce3ef;
                  vertical-align: top; padding: 8px; min-width: 120px; max-width: 140px; }
    .emp-name { font-size: 13px; font-weight: 800; line-height: 1.2; }
    .emp-count { font-size: 11px; color: #6b7c9a; margin-top: 2px; }
    .emp-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%;
               margin-right: 5px; vertical-align: baseline; }
    tr.row-none td.emp-cell { background: #fef2f2; }
    tr.row-none .emp-name { color: #b91c1c; }
    td.slot-cell { vertical-align: top; padding: 6px 5px; border-right: 1px solid #dce3ef;
                   border-bottom: 1px solid #dce3ef; min-width: 170px; max-width: 200px; }
    td.slot-cell.is-today { background: #fff8e1; }
    td.slot-cell.drop-ok { outline: 2px dashed #3a5a99; outline-offset: -3px; }
    tr.row-none td.slot-cell { background: #fef7f7; }
    .card { background: #fff; border-radius: 8px; border-left: 4px solid #3a5a99;
            box-shadow: 0 1px 4px rgba(58,90,153,.12); margin-bottom: 6px; overflow: hidden;
            cursor: grab; }
    .card:active { cursor: grabbing; }
    .card.dragging { opacity: .4; }
    .card:last-child { margin-bottom: 0; }
    .card-head { background: #e8f0fe; padding: 3px 8px; display: flex;
                 align-items: center; justify-content: space-between; gap: 4px; }
    .card-time { font-size: 12px; font-weight: 800; color: #3a5a99; white-space: nowrap; }
    .fdt-badge { font-size: 10px; font-weight: 800; color: #fff; background: #16a34a;
                 border-radius: 4px; padding: 1px 5px; white-space: nowrap; }
    .card-body { padding: 4px 8px 5px; }
    .card-client { font-size: 12px; font-weight: 700; line-height: 1.3; margin-bottom: 2px; }
    .card-ville { font-size: 11px; color: #6b7c9a; }
    .card-extra { font-size: 10.5px; color: #44557a; line-height: 1.35; margin-top: 1px; }
    .card-ref { font-size: 10px; color: #6b7c9a; font-weight: 600; display: block; margin-top: 2px;
                text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }
    .empty-cell { min-height: 34px; }
    footer.pl { text-align: center; padding: 20px; font-size: 11px; color: #a0aec0; }

    .grid-wrap { overflow-x: auto; padding: 12px; }
</style>
</head>
<body>

<t t-set="args" t-value="request.httprequest.args"/>
<t t-set="cfil" t-value="int(args.get('c') or 0)"/>
<t t-set="tnow" t-value="datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)"/>
<t t-set="yr" t-value="tnow.year"/>
<t t-set="dst_a" t-value="max([datetime.date(yr,3,d) for d in range(25,32) if datetime.date(yr,3,d).weekday()==6])"/>
<t t-set="dst_b" t-value="max([datetime.date(yr,10,d) for d in range(25,32) if datetime.date(yr,10,d).weekday()==6])"/>
<t t-set="off" t-value="2 if dst_a &lt;= tnow.date() &lt; dst_b else 1"/>
<t t-set="dtoff" t-value="datetime.timedelta(hours=off)"/>
<t t-set="today" t-value="(tnow + dtoff).date()"/>
<t t-set="emps" t-value="[e for e in request.env['hr.employee'].sudo().search([('active','=',True)], order='name') if e.id != 3]"/>
<t t-set="cols" t-value="[e for e in emps if e.id == cfil] if cfil else emps"/>
<t t-set="palette" t-value="['#2563eb','#16a34a','#ea580c','#9333ea','#0d9488','#db2777','#ca8a04','#4f46e5','#dc2626','#0891b2']"/>
<t t-set="mois_abr" t-value="['jan','fév','mar','avr','mai','juin','juil','août','sep','oct','nov','déc']"/>
<t t-set="jours_fr" t-value="['Lun','Mar','Mer','Jeu','Ven','Sam','Dim']"/>

<t t-set="woff" t-value="int(args.get('w') or 0)"/>
<t t-set="monday" t-value="today - datetime.timedelta(days=today.weekday()) + datetime.timedelta(days=7*woff)"/>
<t t-set="days" t-value="[monday + datetime.timedelta(days=i) for i in range(6)]"/>
<t t-set="su" t-value="datetime.datetime(monday.year, monday.month, monday.day) - dtoff"/>
<t t-set="dom" t-value="[('start_datetime','&gt;=',su),('start_datetime','&lt;',su + datetime.timedelta(days=7))] + ([('employee_ids','in',[cfil])] if cfil else [])"/>
<t t-set="slots" t-value="request.env['planning.slot'].sudo().search(dom, order='start_datetime')"/>
<t t-set="somap" t-value="dict([(o.name, o) for o in request.env['sale.order'].sudo().search([('name','in',[((s.name or '').strip().split() or [''])[0] for s in slots])])])"/>
<t t-set="wend" t-value="monday + datetime.timedelta(days=5)"/>
<t t-set="wlabel" t-value="('S%s — %s au %s %s %s' % (monday.isocalendar()[1], monday.day, wend.day, mois_abr[wend.month-1], wend.year)) if monday.month == wend.month else ('S%s — %s %s au %s %s %s' % (monday.isocalendar()[1], monday.day, mois_abr[monday.month-1], wend.day, mois_abr[wend.month-1], wend.year))"/>
<t t-set="qc" t-value="('&amp;c=%s' % cfil) if cfil else ''"/>

<header>
  <div class="hdr-top">
    <div class="logo">P</div>
    <div style="flex:1">
      <div class="hdr-title">Planning PROTEC</div>
      <div class="hdr-sub">Interventions par chauffeur — glisser une vignette pour déplacer</div>
    </div>
    <div class="badge" t-out="'%s interventions' % len(slots)"/>
  </div>
  <div class="hdr-nav">
    <a t-att-href="'/planning-semaine?w=0%s' % qc" class="nav-btn active">Semaine</a>
    <a t-att-href="'/planning-mois?m=%04d-%02d%s' % (monday.year, monday.month, qc)" class="nav-btn">Mois</a>
    <select class="drv-select" t-att-onchange="&quot;location.href='/planning-semaine?w=%s' + (this.value != '0' ? '&amp;c=' + this.value : '')&quot; % woff">
      <option value="0">Tous les chauffeurs</option>
      <t t-foreach="emps" t-as="e">
        <option t-att-value="e.id" t-att-selected="'selected' if cfil == e.id else None" t-out="e.name"/>
      </t>
    </select>
    <a t-att-href="'/planning-semaine?w=%s%s' % (woff-1, qc)" class="nav-btn">‹</a>
    <span class="period-label" t-out="wlabel"/>
    <a t-att-href="'/planning-semaine?w=%s%s' % (woff+1, qc)" class="nav-btn">›</a>
  </div>
</header>

<div class="grid-wrap">

<table class="pl">
  <thead>
    <tr>
      <th class="emp-col"><div class="th-emp-inner">
        <div class="th-day-dow" style="font-size:11px;">Chauffeur</div></div></th>
      <t t-foreach="days" t-as="day">
        <th t-att-class="'day-th' + (' is-today' if day == today else '')">
          <div class="th-inner">
            <div class="th-day-dow" t-out="jours_fr[day.weekday()]"/>
            <div class="th-day-num" t-out="'%s/%s' % (day.day, day.month)"/>
          </div>
        </th>
      </t>
    </tr>
  </thead>
  <tbody>
    <t t-foreach="cols" t-as="emp">
      <t t-set="color" t-value="palette[emp.id % 10]"/>
      <t t-set="empslots" t-value="[s for s in slots if emp.id in s.employee_ids.ids]"/>
      <tr>
        <td class="emp-cell">
          <div class="emp-name"><span class="emp-dot" t-att-style="'background: %s;' % color"/><t t-out="emp.name"/></div>
          <div class="emp-count" t-out="('%s interv.' % len(empslots)) if empslots else '—'"/>
        </td>
        <t t-foreach="days" t-as="day">
          <td t-att-class="'slot-cell' + (' is-today' if day == today else '')" t-att-data-day="day.isoformat()" t-att-data-emp="emp.id">
            <t t-set="cell" t-value="[s for s in empslots if (s.start_datetime + dtoff).date() == day]"/>
            <t t-if="cell">
              <t t-foreach="cell" t-as="s">
<div class="card" draggable="true" t-att-data-id="s.id" t-att-data-start="s.start_datetime.strftime('%Y-%m-%d %H:%M:%S')" t-att-data-end="s.end_datetime.strftime('%Y-%m-%d %H:%M:%S') if s.end_datetime else ''" t-att-style="'border-left-color: %s;' % color">
  <div class="card-head">
    <span class="card-time" t-out="(s.start_datetime + dtoff).strftime('%H:%M') + ((' → ' + (s.end_datetime + dtoff).strftime('%H:%M')) if s.end_datetime else '')"/>
    <span t-if="s.x_fdt_fait" class="fdt-badge">✓ FDT</span>
  </div>
  <div class="card-body">
    <div class="card-client" t-out="s.partner_id.name or '—'"/>
    <div t-if="s.partner_city" class="card-ville" t-out="'📍 ' + s.partner_city"/>
    <t t-set="so" t-value="somap.get(((s.name or '').strip().split() or [''])[0])"/>
    <div t-if="so and so.x_studio_interlocuteur_1" class="card-extra" t-out="'👤 ' + so.x_studio_interlocuteur_1[:70]"/>
    <div t-if="s.partner_phone" class="card-extra" t-out="'📞 ' + s.partner_phone"/>
    <div t-if="so and so.x_studio_lieu_dintervention_2" class="card-extra" t-out="'🏠 ' + so.x_studio_lieu_dintervention_2[:70]"/>
    <div t-if="so and so.x_studio_lieu_dintervention_1" class="card-extra" t-out="'🛠 ' + so.x_studio_lieu_dintervention_1[:70]"/>
    <span t-if="s.name" class="card-ref" t-out="(s.name or '')[:26]"/>
  </div>
</div>
              </t>
            </t>
            <t t-else=""><div class="empty-cell"/></t>
          </td>
        </t>
      </tr>
    </t>
    <t t-if="not cfil">
      <t t-set="color" t-value="'#ef4444'"/>
      <t t-set="naslots" t-value="[s for s in slots if not [i for i in s.employee_ids.ids if i != 3]]"/>
      <tr class="row-none">
        <td class="emp-cell">
          <div class="emp-name"><span class="emp-dot" style="background: #ef4444;"/>Non assigné</div>
          <div class="emp-count" t-out="('%s interv.' % len(naslots)) if naslots else '—'"/>
        </td>
        <t t-foreach="days" t-as="day">
          <td t-att-class="'slot-cell' + (' is-today' if day == today else '')" t-att-data-day="day.isoformat()" data-emp="0">
            <t t-set="cell" t-value="[s for s in naslots if (s.start_datetime + dtoff).date() == day]"/>
            <t t-if="cell">
              <t t-foreach="cell" t-as="s">
<div class="card" draggable="true" t-att-data-id="s.id" t-att-data-start="s.start_datetime.strftime('%Y-%m-%d %H:%M:%S')" t-att-data-end="s.end_datetime.strftime('%Y-%m-%d %H:%M:%S') if s.end_datetime else ''" t-att-style="'border-left-color: %s;' % color">
  <div class="card-head">
    <span class="card-time" t-out="(s.start_datetime + dtoff).strftime('%H:%M') + ((' → ' + (s.end_datetime + dtoff).strftime('%H:%M')) if s.end_datetime else '')"/>
    <span t-if="s.x_fdt_fait" class="fdt-badge">✓ FDT</span>
  </div>
  <div class="card-body">
    <div class="card-client" t-out="s.partner_id.name or '—'"/>
    <div t-if="s.partner_city" class="card-ville" t-out="'📍 ' + s.partner_city"/>
    <t t-set="so" t-value="somap.get(((s.name or '').strip().split() or [''])[0])"/>
    <div t-if="so and so.x_studio_interlocuteur_1" class="card-extra" t-out="'👤 ' + so.x_studio_interlocuteur_1[:70]"/>
    <div t-if="s.partner_phone" class="card-extra" t-out="'📞 ' + s.partner_phone"/>
    <div t-if="so and so.x_studio_lieu_dintervention_2" class="card-extra" t-out="'🏠 ' + so.x_studio_lieu_dintervention_2[:70]"/>
    <div t-if="so and so.x_studio_lieu_dintervention_1" class="card-extra" t-out="'🛠 ' + so.x_studio_lieu_dintervention_1[:70]"/>
    <span t-if="s.name" class="card-ref" t-out="(s.name or '')[:26]"/>
  </div>
</div>
              </t>
            </t>
            <t t-else=""><div class="empty-cell"/></t>
          </td>
        </t>
      </tr>
    </t>
  </tbody>
</table>

</div>

<footer class="pl">PROTEC S3T — Planning chauffeurs</footer>

<script>
var pdrag = null;
function pad2(n) { return ('0' + n).slice(-2); }
function shiftUTC(str, days) {
  var d = new Date(str.replace(' ', 'T') + 'Z');
  d = new Date(d.getTime() + days * 86400000);
  return d.getUTCFullYear() + '-' + pad2(d.getUTCMonth() + 1) + '-' + pad2(d.getUTCDate())
    + ' ' + pad2(d.getUTCHours()) + ':' + pad2(d.getUTCMinutes()) + ':' + pad2(d.getUTCSeconds());
}
document.addEventListener('dragstart', function (e) {
  var c = e.target.closest ? e.target.closest('.card') : null;
  if (!c) { return; }
  var td = c.closest('td.slot-cell');
  if (!td) { return; }
  pdrag = { id: parseInt(c.dataset.id), start: c.dataset.start, end: c.dataset.end,
            day: td.dataset.day, emp: parseInt(td.dataset.emp) };
  c.classList.add('dragging');
});
document.addEventListener('dragend', function (e) {
  document.querySelectorAll('.card.dragging').forEach(function (el) { el.classList.remove('dragging'); });
  document.querySelectorAll('.drop-ok').forEach(function (el) { el.classList.remove('drop-ok'); });
});
document.addEventListener('dragover', function (e) {
  var td = e.target.closest ? e.target.closest('td.slot-cell') : null;
  if (td) { if (pdrag) { e.preventDefault(); td.classList.add('drop-ok'); } }
});
document.addEventListener('dragleave', function (e) {
  var td = e.target.closest ? e.target.closest('td.slot-cell') : null;
  if (td) { td.classList.remove('drop-ok'); }
});
document.addEventListener('drop', function (e) {
  var td = e.target.closest ? e.target.closest('td.slot-cell') : null;
  if (!td) { return; }
  if (!pdrag) { return; }
  e.preventDefault();
  td.classList.remove('drop-ok');
  var dayDelta = Math.round((new Date(td.dataset.day) - new Date(pdrag.day)) / 86400000);
  var newEmp = parseInt(td.dataset.emp);
  var vals = {};
  if (dayDelta !== 0) {
    vals.start_datetime = shiftUTC(pdrag.start, dayDelta);
    if (pdrag.end) { vals.end_datetime = shiftUTC(pdrag.end, dayDelta); }
  }
  if (newEmp !== pdrag.emp) {
    if (newEmp) { vals.employee_ids = [[6, 0, [newEmp]]]; } else { vals.employee_ids = [[5]]; }
  }
  if (Object.keys(vals).length === 0) { pdrag = null; return; }
  fetch('/web/dataset/call_kw/planning.slot/write', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'same-origin',
    body: JSON.stringify({ jsonrpc: '2.0', method: 'call',
      params: { model: 'planning.slot', method: 'write',
                args: [[pdrag.id], vals], kwargs: {} } })
  }).then(function (r) { return r.json(); }).then(function (d) {
    if (d.error) {
      alert('Modification refusée — connectez-vous à Odoo dans cet onglet pour déplacer les interventions.');
    } else {
      location.reload();
    }
  }).catch(function () { alert('Erreur réseau'); });
  pdrag = null;
});
</script>

</body>
</html>
</t>